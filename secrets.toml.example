# EXEMPLO - Copie este arquivo para .streamlit/secrets.toml
# e substitua os valores pelos seus dados reais

# Nome exato da planilha no Google Sheets
spreadsheet_name = "Simulador Relotação TJPR - Dados"

# Credenciais da Service Account do Google Cloud
# Copie os valores do arquivo JSON baixado
[gcp_service_account]
type = "service_account"
project_id = "seu-projeto-123456"
private_key_id = "abc123def456..."
private_key = "-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"
client_email = "simulador-tjpr@seu-projeto-123456.iam.gserviceaccount.com"
client_id = "123456789012345678901"
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "https://www.googleapis.com/robot/v1/metadata/x509/simulador-tjpr%40seu-projeto-123456.iam.gserviceaccount.com"

# =============================================================================
# CONFIGURAÇÕES DE AUTENTICAÇÃO (OPCIONAL)
# =============================================================================
# Se não configuradas, o sistema usa valores padrão hardcoded.
# Para maior segurança, mova as credenciais para secrets.toml

# Senha de administrador (em produção, use hash bcrypt)
# admin_senha = "sua_senha_segura_aqui"

# Lista de telefones de administradores (separados por vírgula ou array)
# admin_telefones = ["41997813606"]

# Códigos de autenticação (mapeamento telefone -> código)
# Formato: telefone (11 dígitos) = "código"
# [auth_codes]
# "41997813606" = "TJPR-F4F1X5"
# "41988682140" = "TJPR-W9D8A6"
# ... (adicionar todos os códigos aqui)